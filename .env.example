# Compose / PostgreSQL
POSTGRES_DB=article_publisher
POSTGRES_USER=article_publisher
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://article_publisher:change-me@db:5432/article_publisher

# Backend
APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-strong-application-password
BACKEND_CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=25
MAX_DOCX_UNCOMPRESSED_MB=200
WORDPRESS_MEDIA_MAX_MB=1
ARTICLE_STORAGE_PATH=/app/.data
LOG_LEVEL=INFO

# Frontend (browser-accessible URL)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# WordPress (required in Phase 2; use an Application Password)
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# Rank Math (Phase 3)
RANK_MATH_ENDPOINT=

# Google APIs (Phase 9+; path inside the backend container)
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
